*.obj
*.a
*.lib
*.exe
*.wasm
*.wasm.map

# Emscripten
.emscripten_cache/

# Editor / OS
.vs/
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# Logs
*.log
